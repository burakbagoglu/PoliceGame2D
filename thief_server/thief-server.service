[Unit]
Description=Thief Game Server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/thief_server
Environment=PYTHONUNBUFFERED=1
Environment=THIEF_SERVER_CONFIG=/home/pi/thief_server/config.json
Environment=SDL_AUDIODRIVER=alsa
ExecStart=/usr/bin/python3 /home/pi/thief_server/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
